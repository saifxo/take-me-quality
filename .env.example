# ---------------------------------------------------------------
# Take Me Quality (TMQ) — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------

# Postgres connection. Locally this is the Docker container from docker-compose.yml.
# On Vercel + Neon, the Neon integration fills DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED automatically.
DATABASE_URL=postgres://tmq:tmq_local_pw@localhost:5433/tmq
DATABASE_URL_UNPOOLED=

# Used only by the automated test suite (npm test).
TEST_DATABASE_URL=postgres://tmq:tmq_local_pw@localhost:5433/tmq_test

# Long random string (32+ chars). Keys the caller-number hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Session lifetime (hours) and idle timeout (minutes).
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# Google Gemini (optional — AI features stay switched off until a key is set).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_PER_USER=40

# First admin account created by `npm run db:seed` (change the password after first sign-in).
SEED_ADMIN_EMAIL=admin@takeme.taxi
SEED_ADMIN_PASSWORD=TakeMe-Quality-2026!
